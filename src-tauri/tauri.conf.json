{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/tauri-v1.6.0/core/tauri-config-schema/schema.json",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "distDir": "../dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Isolate Client",
    "version": "0.2.1"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": {
        "open": true
      },
      "shell": {
        "all": false,
        "open": true
      },
      "window": {
        "setSize": true,
        "setCursorGrab": true,
        "setTitle": true,
        "minimize": true,
        "maximize": true,
        "unmaximize": true,
        "close": true,
        "startDragging": true
      },
      "protocol": {
        "asset": true,
        "assetScope": {
          "allow": [
            "**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "dev.isolate.client",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "category": "Game",
      "shortDescription": "A lean Minecraft launcher",
      "longDescription": "Isolate Client \u2014 a fast, minimal Minecraft launcher.",
      "windows": {
        "nsis": {
          "template": "installer-custom.nsi",
          "installMode": "perMachine",
          "compression": "lzma"
        }
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Isolate Client",
        "width": 1180,
        "height": 740,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "fileDropEnabled": false,
        "decorations": false,
        "transparent": false
      }
    ]
  }
}