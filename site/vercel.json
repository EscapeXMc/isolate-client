{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "true",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/__diag", "destination": "/api/diag" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/plans", "destination": "/plans/index.html" },
    { "source": "/plans/", "destination": "/plans/index.html" },
    { "source": "/uninstall", "destination": "/uninstall.html" },
    { "source": "/uninstall/", "destination": "/uninstall.html" },
    { "source": "/preview", "destination": "/preview.html" },
    { "source": "/preview/", "destination": "/preview.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/privacy/", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/terms/", "destination": "/terms.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/faq/", "destination": "/faq.html" },
    { "source": "/download", "destination": "/download.html" },
    { "source": "/download/", "destination": "/download.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/contact/", "destination": "/contact.html" },
    { "source": "/store", "destination": "/store.html" },
    { "source": "/store/", "destination": "/store.html" },
    { "source": "/track", "destination": "/track.html" },
    { "source": "/track/", "destination": "/track.html" },
    { "source": "/team", "destination": "/team.html" },
    { "source": "/team/", "destination": "/team.html" },
    { "source": "/subdomains", "destination": "/subdomains/index.html" },
    { "source": "/subdomains/", "destination": "/subdomains/index.html" },
    { "source": "/account", "destination": "/account/index.html" },
    { "source": "/account/", "destination": "/account/index.html" },
    { "source": "/index-de", "destination": "/index-de.html" },
    { "source": "/index-es", "destination": "/index-es.html" },
    { "source": "/index-fr", "destination": "/index-fr.html" },
    { "source": "/index-nl", "destination": "/index-nl.html" },
    { "source": "/18nov", "destination": "/18nov/index.html" },
    { "source": "/18nov/", "destination": "/18nov/index.html" }
  ]
}
